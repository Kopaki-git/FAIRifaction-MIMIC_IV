digraph FAIR_MIMIC_Semantic_Model {
  graph [
    label="FAIRification MIMIC-IV Demo — proposed semantic model audit graph",
    labelloc=t,
    fontsize=22,
    fontname="Helvetica",
    rankdir=LR,
    splines=spline,
    overlap=false,
    nodesep=0.35,
    ranksep=0.85,
    pad=0.25,
    bgcolor="white"
  ];

  node [fontname="Helvetica", fontsize=10, margin="0.08,0.05"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75];

  // ---------------------------------------------------------------------------
  // Legend and audit notes
  // ---------------------------------------------------------------------------
  legend [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>Rounded box</B></TD><TD ALIGN="LEFT">FHIR Resource</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Rectangle</B></TD><TD ALIGN="LEFT">FHIR backbone / complex datatype</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Ellipse</B></TD><TD ALIGN="LEFT">Source value, literal, code, or terminology object</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Solid edge</B></TD><TD ALIGN="LEFT">FHIR property/path in proposed model</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Dashed edge</B></TD><TD ALIGN="LEFT">Mapping / conditional / deferred assertion</TD></TR>
    </TABLE>
  >];

  identity_note [shape=note, fontsize=9, label="Identity invariant\nsubject_id / hadm_id / stay_id are MIMIC-local identifiers,\nnot RDF/FHIR resource identity.\nResource URI/ID scheme is deferred."];

  profile_note [shape=note, fontsize=9, label="FHIR R4 Vital Signs profile\nAll three Observation types are designed to conform.\nExplicit meta.profile is asserted only after validator success."];

  careunit_note [shape=note, fontsize=9, label="Careunit mapping encoding remains an audit point\nMapping strengths are frozen (2 exactMatch, 7 broadMatch),\nbut broad mappings must not be encoded as if they were equivalent codings."];

  // ---------------------------------------------------------------------------
  // FHIR Resources
  // ---------------------------------------------------------------------------
  subgraph cluster_resources {
    label="FHIR resources";
    color="#b5b5b5";
    style="rounded";

    patient [shape=box, style="rounded,bold", penwidth=1.4, label="Patient"];
    hospital_enc [shape=box, style="rounded,bold", penwidth=1.4, label="Encounter\nHospital admission"];
    icu_enc [shape=box, style="rounded,bold", penwidth=1.4, label="Encounter\nICU stay"];
    observation [shape=box, style="rounded,bold", penwidth=1.4, label="Observation\nHR / RR / SpO2\n(one source row = one resource)"];
    location [shape=box, style="rounded,bold", penwidth=1.4, label="Location\nReusable care-unit kind"];
    condition [shape=box, style="rounded,bold", penwidth=1.4, label="Condition\nFirst-ranked encounter diagnosis"];
  }

  // ---------------------------------------------------------------------------
  // Patient identifiers
  // ---------------------------------------------------------------------------
  patient_identifier [shape=box, label="Identifier"];
  subject_id [shape=ellipse, label="subject_id\n(source value)"];

  patient -> patient_identifier [label="fhir:Patient.identifier"];
  patient_identifier -> subject_id [label="fhir:Identifier.value"];
  identity_note -> patient [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // Hospital Encounter
  // ---------------------------------------------------------------------------
  hospital_identifier [shape=box, label="Identifier"];
  hadm_id [shape=ellipse, label="hadm_id\n(source value)"];
  hospital_period [shape=box, label="Period"];
  admittime [shape=ellipse, label="admittime\n(source datetime)"];
  dischtime [shape=ellipse, label="dischtime\n(source datetime)"];
  admission_class [shape=ellipse, label="Encounter.class Coding\nMIMIC-local admission_type\n(system URI TBD)\ncode = source admission_type"];

  hospital_enc -> patient [label="fhir:Encounter.subject"];
  hospital_enc -> hospital_identifier [label="fhir:Encounter.identifier"];
  hospital_identifier -> hadm_id [label="fhir:Identifier.value"];
  hospital_enc -> hospital_period [label="fhir:Encounter.period"];
  hospital_period -> admittime [label="fhir:Period.start"];
  hospital_period -> dischtime [label="fhir:Period.end"];
  hospital_enc -> admission_class [label="fhir:Encounter.class"];
  identity_note -> hospital_enc [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // ICU Encounter
  // ---------------------------------------------------------------------------
  icu_identifier [shape=box, label="Identifier"];
  stay_id [shape=ellipse, label="stay_id\n(source value)"];
  icu_period [shape=box, label="Period"];
  icu_intime [shape=ellipse, label="icustays.intime\n(source datetime)"];
  icu_outtime [shape=ellipse, label="icustays.outtime\n(source datetime)"];

  icu_enc -> patient [label="fhir:Encounter.subject"];
  icu_enc -> hospital_enc [label="fhir:Encounter.partOf"];
  icu_enc -> icu_identifier [label="fhir:Encounter.identifier"];
  icu_identifier -> stay_id [label="fhir:Identifier.value"];
  icu_enc -> icu_period [label="fhir:Encounter.period"];
  icu_period -> icu_intime [label="fhir:Period.start"];
  icu_period -> icu_outtime [label="fhir:Period.end"];
  identity_note -> icu_enc [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // Encounter.location and Location
  // ---------------------------------------------------------------------------
  encounter_location [shape=box, label="Encounter.location[]\n(one element per transfer interval)"];
  transfer_period [shape=box, label="Period"];
  transfer_intime [shape=ellipse, label="transfers.intime\n(source datetime)"];
  transfer_outtime [shape=ellipse, label="transfers.outtime\n(source datetime)"];
  location_mode [shape=ellipse, label="kind"];
  location_type [shape=box, label="CodeableConcept\nLocation.type"];
  mimic_careunit [shape=ellipse, label="MIMIC careunit coding\ncode/display = transfers.careunit\n(local system URI TBD)"];

  icu_enc -> encounter_location [label="fhir:Encounter.location"];
  encounter_location -> transfer_period [label="fhir:Encounter.location.period"];
  transfer_period -> transfer_intime [label="fhir:Period.start"];
  transfer_period -> transfer_outtime [label="fhir:Period.end"];
  encounter_location -> location [label="fhir:Encounter.location.location"];
  location -> location_mode [label="fhir:Location.mode"];
  location -> location_type [label="fhir:Location.type"];
  location_type -> mimic_careunit [label="fhir:CodeableConcept.coding"];

  careunit_map [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3"><B>Approved MIMIC careunit → SNOMED CT mappings</B></TD></TR>
      <TR><TD><B>MIMIC careunit</B></TD><TD><B>relation</B></TD><TD><B>SNOMED CT target</B></TD></TR>
      <TR><TD ALIGN="LEFT">Medical Intensive Care Unit (MICU)</TD><TD>exactMatch</TD><TD ALIGN="LEFT">441994008 Medical intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Surgical Intensive Care Unit (SICU)</TD><TD>exactMatch</TD><TD ALIGN="LEFT">418433008 Surgical intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Medical/Surgical Intensive Care Unit (MICU/SICU)</TD><TD>broadMatch</TD><TD ALIGN="LEFT">309904001 Intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Trauma SICU (TSICU)</TD><TD>broadMatch</TD><TD ALIGN="LEFT">418433008 Surgical intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Neuro Surgical Intensive Care Unit (Neuro SICU)</TD><TD>broadMatch</TD><TD ALIGN="LEFT">309909006 Neurological intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Neuro Stepdown</TD><TD>broadMatch</TD><TD ALIGN="LEFT">419590001 Stepdown unit</TD></TR>
      <TR><TD ALIGN="LEFT">Cardiac Vascular Intensive Care Unit (CVICU)</TD><TD>broadMatch</TD><TD ALIGN="LEFT">309904001 Intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Coronary Care Unit (CCU)</TD><TD>broadMatch</TD><TD ALIGN="LEFT">309907008 Cardiac intensive care unit</TD></TR>
      <TR><TD ALIGN="LEFT">Neuro Intermediate</TD><TD>broadMatch</TD><TD ALIGN="LEFT">397771005 High dependency unit</TD></TR>
    </TABLE>
  >];

  mimic_careunit -> careunit_map [style=dashed, label="approved terminology mapping\nFHIR encoding to audit"];
  careunit_note -> careunit_map [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // Observation structure
  // ---------------------------------------------------------------------------
  obs_status [shape=ellipse, label="final\n(conversion policy, not source field)"];
  obs_category [shape=box, label="CodeableConcept\nObservation.category"];
  vital_signs [shape=ellipse, label="system = http://terminology.hl7.org/CodeSystem/observation-category\ncode = vital-signs"];
  charttime [shape=ellipse, label="charttime\n(source datetime)"];
  obs_code [shape=box, label="CodeableConcept\nObservation.code"];
  mimic_item_coding [shape=ellipse, label="MIMIC item coding\ncode = itemid\ndisplay = measurement_label\n(local system URI TBD)"];
  loinc_coding [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3"><B>LOINC coding added to Observation.code</B></TD></TR>
      <TR><TD><B>MIMIC itemid</B></TD><TD><B>LOINC</B></TD><TD><B>label</B></TD></TR>
      <TR><TD>220045</TD><TD>8867-4</TD><TD ALIGN="LEFT">Heart rate</TD></TR>
      <TR><TD>220210</TD><TD>9279-1</TD><TD ALIGN="LEFT">Respiratory rate</TD></TR>
      <TR><TD>220277</TD><TD>2708-6</TD><TD ALIGN="LEFT">Oxygen saturation in arterial blood</TD></TR>
      <TR><TD>220277</TD><TD>59408-5</TD><TD ALIGN="LEFT">Oxygen saturation in arterial blood by pulse oximetry</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="LEFT">Coding.system = http://loinc.org</TD></TR>
    </TABLE>
  >];

  quantity [shape=box, label="Quantity\nObservation.valueQuantity"];
  valuenum [shape=ellipse, label="valuenum\n(source numeric value)"];
  raw_unit [shape=ellipse, label="valueuom\nsource string retained verbatim\nQuantity.unit"];
  ucum_system [shape=ellipse, label="http://unitsofmeasure.org\nQuantity.system"];
  ucum_code [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2"><B>UCUM code</B></TD></TR>
      <TR><TD><B>source valueuom</B></TD><TD><B>Quantity.code</B></TD></TR>
      <TR><TD>bpm</TD><TD>/min</TD></TR>
      <TR><TD>insp/min</TD><TD>/min</TD></TR>
      <TR><TD>%</TD><TD>%</TD></TR>
    </TABLE>
  >];

  warning_extension [shape=box, label="Extension\nObservation warning"];
  warning_url [shape=ellipse, label="canonical extension URL\nTBD with project namespace/publication"];
  warning_value [shape=ellipse, label="warning\n0 → false\n1 → true\n(valueBoolean)"];

  vital_profile [shape=ellipse, label="http://hl7.org/fhir/StructureDefinition/vitalsigns"];

  observation -> patient [label="fhir:Observation.subject"];
  observation -> icu_enc [label="fhir:Observation.encounter"];
  observation -> obs_status [label="fhir:Observation.status"];
  observation -> obs_category [label="fhir:Observation.category"];
  obs_category -> vital_signs [label="fhir:CodeableConcept.coding"];
  observation -> charttime [label="fhir:Observation.effectiveDateTime"];
  observation -> obs_code [label="fhir:Observation.code"];
  obs_code -> mimic_item_coding [label="fhir:CodeableConcept.coding"];
  obs_code -> loinc_coding [label="fhir:CodeableConcept.coding\n(mapping by itemid)"];
  observation -> quantity [label="fhir:Observation.valueQuantity"];
  quantity -> valuenum [label="fhir:Quantity.value"];
  quantity -> raw_unit [label="fhir:Quantity.unit"];
  quantity -> ucum_system [label="fhir:Quantity.system"];
  quantity -> ucum_code [label="fhir:Quantity.code\n(mapping by valueuom)"];
  observation -> warning_extension [label="fhir:Observation.extension"];
  warning_extension -> warning_url [label="fhir:Extension.url"];
  warning_extension -> warning_value [label="fhir:Extension.valueBoolean"];
  observation -> vital_profile [style=dashed, label="fhir:Resource.meta.profile\nONLY after validator success"];
  profile_note -> vital_profile [style=dotted, arrowhead=none];
  identity_note -> observation [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // Diagnosis / Condition structure
  // ---------------------------------------------------------------------------
  diagnosis_backbone [shape=box, label="Encounter.diagnosis[]\nselected source row: seq_num = 1"];
  diagnosis_rank [shape=ellipse, label="1\n(first-ranked, not causal/clinical primacy)"];
  diagnosis_use [shape=ellipse, label="billing"];
  condition_category [shape=box, label="CodeableConcept\nCondition.category"];
  encounter_diagnosis [shape=ellipse, label="system = http://terminology.hl7.org/CodeSystem/condition-category\ncode = encounter-diagnosis"];
  condition_code [shape=box, label="CodeableConcept\nCondition.code"];
  mimic_icd [shape=ellipse, label="Original MIMIC ICD coding\ncode = diagnoses_icd.icd_code\nversion = diagnoses_icd.icd_version\noriginal code always retained\n(local MIMIC system URI strategy TBD)"];
  canonical_icd [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3"><B>Validated canonical ICD coding added alongside source coding</B></TD></TR>
      <TR><TD><B>source version</B></TD><TD><B>Coding.system</B></TD><TD><B>code treatment</B></TD></TR>
      <TR><TD>9</TD><TD ALIGN="LEFT">http://hl7.org/fhir/sid/icd-9-cm</TD><TD ALIGN="LEFT">canonical ICD-9-CM punctuation</TD></TR>
      <TR><TD>10</TD><TD ALIGN="LEFT">http://hl7.org/fhir/sid/icd-10-cm</TD><TD ALIGN="LEFT">canonical ICD-10-CM punctuation, X placeholders retained</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="LEFT">No Coding.version asserted; historical retired codes are preserved rather than upgraded.</TD></TR>
    </TABLE>
  >];

  hospital_enc -> diagnosis_backbone [label="fhir:Encounter.diagnosis"];
  diagnosis_backbone -> condition [label="fhir:Encounter.diagnosis.condition"];
  diagnosis_backbone -> diagnosis_rank [label="fhir:Encounter.diagnosis.rank"];
  diagnosis_backbone -> diagnosis_use [label="fhir:Encounter.diagnosis.use"];
  condition -> patient [label="fhir:Condition.subject"];
  condition -> hospital_enc [label="fhir:Condition.encounter"];
  condition -> condition_category [label="fhir:Condition.category"];
  condition_category -> encounter_diagnosis [label="fhir:CodeableConcept.coding"];
  condition -> condition_code [label="fhir:Condition.code"];
  condition_code -> mimic_icd [label="fhir:CodeableConcept.coding"];
  condition_code -> canonical_icd [label="fhir:CodeableConcept.coding\nonly after code validation"];
  identity_note -> condition [style=dotted, arrowhead=none];

  // ---------------------------------------------------------------------------
  // Layout hints: keep the clinical spine prominent
  // ---------------------------------------------------------------------------
  { rank=same; observation; icu_enc; hospital_enc; patient; }
  { rank=same; location; condition; }
  { rank=min; legend; identity_note; profile_note; careunit_note; }
}
