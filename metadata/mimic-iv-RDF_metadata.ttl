        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle>
    ], [
        a dcat:Distribution ;
        dct:title "ICU vital-signs extract — five linked CSV tables" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group04/dataset/mimic-iv/csv> ;
        dct:format "CSV" ;
