    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group04/dataset/mimic-iv" ;
    dcat:theme <http://id.nlm.nih.gov/mesh/D007362> ;
    dcat:distribution <https://physionet.org/content/mimiciv/2.2/>, [
        a dcat:Distribution ;
        dct:title "MIMIC-IV ICU vitals (4h), FHIR-based RDF" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group04/dataset/mimic-iv/rdf> ;
